  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Layer1BorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AdonisBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AdonisCornerRadius}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>

        <Panel>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
          <Border Name="PART_InnerShadow" IsVisible="False" ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Opacity="0.5"
                  BoxShadow="inset 0 3 8 0 #000000"/>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" RecognizesAccessKey="True" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]">
      <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]">
      <Setter Property="Background" Value="{DynamicResource Layer3BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]">
      <Setter Property="Background" Value="{DynamicResource Layer4BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4BorderBrush}"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer1HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer1HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer2HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer3HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer4HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Layer1HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:pressed">
      <Setter Property="Background" Value="{DynamicResource Layer2HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:pressed">
      <Setter Property="Background" Value="{DynamicResource Layer3HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:pressed">
      <Setter Property="Background" Value="{DynamicResource Layer4HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer0BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer3BackgroundBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Border#PART_InnerShadow">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^.ToolbarToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
    <Style Selector="^.ToolbarToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer1HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer1HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2].ToolbarToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer2HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3].ToolbarToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer3HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4].ToolbarToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer4HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^.ToolbarToggleButton:disabled">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AdonisToggleSwitchTheme" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Layer1BorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AdonisBorderThickness}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>

        <Grid ColumnDefinitions="28,8,*" Background="Transparent">
          <Panel Height="14" VerticalAlignment="Center">
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border Name="PART_Knob" Background="{TemplateBinding Foreground}" Margin="4,0" Width="8" Height="8" CornerRadius="4"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.5" RenderTransform="translateX(0px)">
              <Border.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
              </Border.Transitions>
            </Border>
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]">
      <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]">
      <Setter Property="Background" Value="{DynamicResource Layer3BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]">
      <Setter Property="Background" Value="{DynamicResource Layer4BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4BorderBrush}"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer1HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer1HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer2HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer3HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer4HighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4HighlightBorderBrush}"/>
    </Style>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Knob">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="RenderTransform" Value="translateX(12px)"/>
    </Style>
    <Style Selector="^:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:checked:not(:disabled) /template/ Border#PART_Knob">
      <Setter Property="Background" Value="{DynamicResource AccentForegroundBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
      <Setter Property="Background" Value="{DynamicResource Layer0BackgroundBrush}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Layer1BorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AdonisBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AdonisCornerRadius}"/>
    <Setter Property="Padding" Value="4,0,0,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <ControlTemplate>

        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border Name="PART_Box" Width="14" Height="14" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Panel Margin="2">
              <Path Name="PART_CheckMark" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" IsVisible="False"
                    Data="M 0.5 0.5 L 7.5 7.5 M 0.5 7.5 L 7.5 0.5"/>
              <Border Name="PART_Indeterminate" Width="7" Height="7" Background="{TemplateBinding Foreground}" IsVisible="False"/>
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]">
      <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]">
      <Setter Property="Background" Value="{DynamicResource Layer3BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3BorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]">
      <Setter Property="Background" Value="{DynamicResource Layer4BackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4BorderBrush}"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer1IntenseHighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer1IntenseHighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer2IntenseHighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer2IntenseHighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer3IntenseHighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer3IntenseHighlightBorderBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:pointerover">
      <Setter Property="Background" Value="{DynamicResource Layer4IntenseHighlightBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer4IntenseHighlightBorderBrush}"/>
    </Style>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer0BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=2]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=3]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}"/>
    </Style>
    <Style Selector="^[(ui|LayerExtension.ComputedLayer)=4]:disabled">
      <Setter Property="Background" Value="{DynamicResource Layer3BackgroundBrush}"/>
    </Style>
    <Style Selector="^:checked /template/ Path#PART_CheckMark">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Indeterminate">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Layer1BackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Layer1BorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource AdonisBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource AdonisCornerRadius}"/>
    <Setter Property="Padding" Value="4,0,0,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
