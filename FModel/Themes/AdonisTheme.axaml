<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Background" Value="Red" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="8"><ContentPresenter Content="{TemplateBinding Content}"/></Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[(LayerExtension.ComputedLayer)=2]">
        <Setter Property="Background" Value="Green" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
