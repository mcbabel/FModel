<FWindow x:Class="FModel.Views.ImageMerger"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:settings="using:FModel.Settings"
         Title="Image Merger"
         WindowStartupLocation="CenterScreen"
         DragDrop.AllowDrop="True">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" LayerExtension.Layer="2"
                  Padding="0" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ImagesListBox" Grid.Row="0" SelectionMode="Multiple" />
                <Separator Grid.Row="1" Classes="CustomSeparator" Tag="COMMANDS" />
                <Grid Grid.Row="2" Margin="0 0 0 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Images Per Row" VerticalAlignment="Center" Margin="0 0 10 0" />
                    <Slider x:Name="SizeSlider" Grid.Row="0" Grid.Column="1" TickPlacement="None" IsSnapToTickEnabled="True"
                            Minimum="1" Maximum="20" TickFrequency="1"
                            ToolTip.Tip="{Binding #SizeSlider.Value, StringFormat='{}{0:0}'}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Margin Between Images" VerticalAlignment="Center" Margin="0 0 10 0" />
                    <Slider x:Name="MarginSlider" Grid.Row="2" Grid.Column="1" IsSnapToTickEnabled="True"
                            Value="{Binding ImageMergerMargin, Source={x:Static settings:UserSettings.Default}, Mode=TwoWay}"
                            TickPlacement="None" Minimum="0" Maximum="50" TickFrequency="1"
                            ToolTip.Tip="{Binding #MarginSlider.Value, StringFormat='{}{0:0}'}" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="AddButton" Content="Add" MinWidth="80" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="OnImageAdd"/>
                    <Button x:Name="UpButton" Content="🡹" MinWidth="40" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="ModifyItemInList"/>
                    <Button x:Name="DownButton" Content="🡻" MinWidth="40" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="ModifyItemInList"/>
                    <Button x:Name="DeleteButton" Content="Remove" MinWidth="80" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="ModifyItemInList"/>
                    <Button x:Name="ClearButton" Content="Clear" MinWidth="80" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="OnClear"/>
                    <Button x:Name="OpenImageButton" Content="Open Image" MinWidth="100" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="OnOpenImage"/>
                    <Button x:Name="SaveImageButton" Content="Save Image" MinWidth="100" Padding="1,3,1,3" HorizontalContentAlignment="Center" Click="OnSaveImage"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#525463" BorderThickness="1" Background="#272833">
                <Image x:Name="ImagePreview" Width="512" Height="512" RenderOptions.BitmapInterpolationMode="HighQuality">
                    <Image.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="OnCopyImage">
                                <MenuItem.Icon>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource CopyIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save" Click="OnSaveImage">
                                <MenuItem.Icon>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SaveIcon}" />
                                        </Canvas>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
            </Border>
        </Grid>
    </Grid>
</FWindow>
