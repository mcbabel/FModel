<FWindow x:Class="FModel.Views.ExportSessionWindow"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:views="using:FModel.Views"
         xmlns:vm="using:FModel.ViewModels"
         xmlns:converters="using:FModel.Views.Resources.Converters"
         xmlns:controls="using:FModel.Views.Resources.Controls"
         DataContext="{x:Static vm:ExportSessionViewModel.Instance}"
         Title="Export Session"
         WindowStartupLocation="CenterScreen" CanResize="False">
    <FWindow.Styles>
        <!-- WPF StretchTreeViewItemStyle (class groups, object groups and log entries) -->
        <Style Selector="TreeView#LogTree TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*">
                        <Border Name="PART_LayoutRoot" Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="Auto,*">
                                <ToggleButton Name="PART_ExpandCollapseChevron" Grid.Column="0"
                                              Width="16" Height="16" Margin="8,0,8,0"
                                              Focusable="False" ClickMode="Press"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                              RenderTransformOrigin="50%,50%">
                                    <ToggleButton.Template>
                                        <ControlTemplate>
                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24" Background="Transparent">
                                                    <Path Fill="{TemplateBinding Foreground}" Data="{StaticResource ArrowIcon}" />
                                                </Canvas>
                                            </Viewbox>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="0,4,8,4" />
                            </Grid>
                        </Border>
                        <ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="1" Margin="32,0,0,0"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        IsVisible="{TemplateBinding IsExpanded}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TreeView#LogTree TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TreeView#LogTree TreeViewItem:expanded /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="TreeView#LogTree TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="TreeView#LogTree TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource Layer2HighlightBrush}" />
        </Style>
        <Style Selector="TreeView#LogTree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Layer2IntenseHighlightBrush}" />
        </Style>
        <!-- WPF ItemContainerStyle trigger: a lone class group is always expanded -->
        <Style Selector="TreeView#LogTree[ItemCount=1] > TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <!-- log entries have no IsExpanded property in their view model -->
        <Style Selector="TreeView#LogTree > TreeViewItem > TreeViewItem > TreeViewItem">
            <Setter Property="IsExpanded" Value="False" />
        </Style>
        <!-- WPF ExceptionTreeViewItemStyle (exception details under a log entry) -->
        <Style Selector="TreeView#LogTree > TreeViewItem > TreeViewItem > TreeViewItem > TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_HeaderPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Margin="0,2,8,6" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- WPF DataTriggers on LogEntryViewModel.Level -->
        <Style Selector="Path.LevelIcon">
            <Setter Property="Fill" Value="{DynamicResource DisabledForegroundBrush}" />
            <Setter Property="Data" Value="{StaticResource BugIcon}" />
        </Style>
        <Style Selector="Path.LevelIcon.verbose">
            <Setter Property="Data" Value="{StaticResource NoteIcon}" />
        </Style>
        <Style Selector="Path.LevelIcon.information">
            <Setter Property="Fill" Value="#42A5F5" />
            <Setter Property="Data" Value="{StaticResource InfoIcon}" />
        </Style>
        <Style Selector="Path.LevelIcon.warning">
            <Setter Property="Fill" Value="#FFA726" />
            <Setter Property="Data" Value="{StaticResource WarningIcon}" />
        </Style>
        <Style Selector="Path.LevelIcon.error">
            <Setter Property="Fill" Value="#EF5350" />
            <Setter Property="Data" Value="{StaticResource CloseIcon}" />
        </Style>

        <!-- WPF DataTriggers on IsCanceled / IsFinished -->
        <Style Selector="TextBlock#CurrentItemText">
            <Setter Property="Text" Value="{Binding CurrentItemName, Mode=OneWay, FallbackValue=/}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock#CurrentItemText.canceled">
            <Setter Property="Text" Value="Export canceled" />
            <Setter Property="Foreground" Value="#EF5350" />
        </Style>
        <Style Selector="TextBlock#CurrentItemText.finished">
            <Setter Property="Text" Value="Export finished" />
            <Setter Property="Foreground" Value="#66BB6A" />
        </Style>
    </FWindow.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding ElapsedTime, Mode=OneWay, Converter={x:Static converters:TimeSpanConverter.Instance}, ConverterParameter=elapsed, FallbackValue=00:00.00}"
                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" HorizontalAlignment="Right">
                    <Run Text="ETA " Foreground="{DynamicResource DisabledForegroundBrush}" />
                    <Run Foreground="{DynamicResource ForegroundBrush}"
                         Text="{Binding EtaTime, Mode=OneWay, Converter={x:Static converters:TimeSpanConverter.Instance}, FallbackValue=--:--}" />
                </TextBlock>
                <TextBlock x:Name="CurrentItemText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="220"
                           Classes.canceled="{Binding IsCanceled}"
                           Classes.finished="{Binding IsFinished}" />
            </Grid>

            <Grid DockPanel.Dock="Left" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Session.TotalQueued, Mode=OneWay, FallbackValue=0}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="in queue" FontSize="10"
                           Foreground="{DynamicResource DisabledForegroundBrush}" />

                <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1" Margin="16 2"
                           Fill="{DynamicResource DisabledForegroundBrush}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding CompletedCount, Mode=OneWay, FallbackValue=0}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="completed" FontSize="10"
                           Foreground="{DynamicResource DisabledForegroundBrush}" />

                <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="1" Margin="16 2"
                           Fill="{DynamicResource DisabledForegroundBrush}" />

                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="{Binding SucceededCount, Mode=OneWay, FallbackValue=0}"
                           FontSize="20" FontWeight="SemiBold" Foreground="#66BB6A" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="succeeded" FontSize="10"
                           Foreground="{DynamicResource DisabledForegroundBrush}" />

                <TextBlock Grid.Row="0" Grid.Column="5" Margin="5 0 0 0"
                           Text="{Binding FailedCount, Mode=OneWay, FallbackValue=0}"
                           FontSize="20" FontWeight="SemiBold" Foreground="#EF5350" />
                <TextBlock Grid.Row="1" Grid.Column="5" Text="failed" FontSize="10" Margin="5 0 0 0"
                           Foreground="{DynamicResource DisabledForegroundBrush}" />
            </Grid>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="5" MinHeight="5" Margin="0 5 0 5" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay, FallbackValue=0.5}" />

        <TabControl x:Name="Tabs" Grid.Row="2" LayerExtension.Layer="2"
                    Background="{DynamicResource Layer0BackgroundBrush}">
            <TabItem Header="Export Logs">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                               Text="Start an export to see results here." FontWeight="SemiBold"
                               Foreground="{DynamicResource DisabledForegroundBrush}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static views:ExportSessionWindow.PlaceholderVisibilityConverter}">
                                <Binding Path="IsRunning" />
                                <Binding Path="ClassGroups.Count" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>

                    <TreeView x:Name="LogTree" ItemsSource="{Binding ClassGroups}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ClassGroupViewModel" ItemsSource="{Binding Objects}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />

                                    <Grid Grid.Column="1" Margin="5 0 0 0" IsVisible="{Binding HasErrors}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0 0 5 0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#EF5350" Data="{StaticResource CloseIcon}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{Binding ErrorCount}" Foreground="#EF5350" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="5 0 0 0"
                                               Foreground="{DynamicResource DisabledForegroundBrush}"
                                               Text="{Binding Objects.Count, Mode=OneWay, StringFormat='({0})'}"
                                               ToolTip.Tip="Assets sharing the same name across different packages are grouped together in this view. Exports are not affected." />
                                </Grid>
                            </TreeDataTemplate>

                            <TreeDataTemplate DataType="vm:ObjectGroupViewModel" ItemsSource="{Binding Entries}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0 0 5 0" VerticalAlignment="Center"
                                             IsVisible="{Binding HasErrors}">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#EF5350" Data="{StaticResource CloseIcon}" />
                                        </Canvas>
                                    </Viewbox>

                                    <TextBlock Grid.Column="1" Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Path}">
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource ForegroundBrush}" />
                                        <Run Text=" - " Foreground="{DynamicResource DisabledForegroundBrush}" />
                                        <Run Text="{Binding Directory, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource DisabledForegroundBrush}" />
                                    </TextBlock>

                                    <Button Grid.Column="2" ToolTip.Tip="Remove from queue" Click="OnRemoveFromQueueClick"
                                            IsVisible="{Binding $parent[Window].DataContext.CanExport}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Margin="0" Focusable="False"
                                            Foreground="#EF5350" Classes="ToolbarButton">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding $parent[Button].Foreground}" Data="{StaticResource RemoveIcon}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>

                                    <Button Grid.Column="3" ToolTip.Tip="Open in Explorer" Click="OnOpenInExplorerClick"
                                            Tag="{Binding FirstFilePath}"
                                            IsVisible="{Binding HasFilePath}"
                                            Classes="ToolbarButton"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Margin="0">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path StrokeThickness="2" Stroke="{DynamicResource ForegroundBrush}" Data="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                                                <Path StrokeThickness="2" Stroke="{DynamicResource ForegroundBrush}" Data="M11 13l9 -9" />
                                                <Path StrokeThickness="2" Stroke="{DynamicResource ForegroundBrush}" Data="M15 4h5v5" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </TreeDataTemplate>

                            <TreeDataTemplate DataType="vm:LogEntryViewModel" ItemsSource="{Binding ExceptionDetails}">
                                <Grid Margin="0 1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0 0 5 0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Classes="LevelIcon"
                                                  Classes.verbose="{Binding Level, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Verbose}"
                                                  Classes.information="{Binding Level, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Information}"
                                                  Classes.warning="{Binding Level, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Warning}"
                                                  Classes.error="{Binding Level, Converter={x:Static views:ExportSessionWindow.IsErrorLevelConverter}}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}"
                                               FontSize="11" Margin="0 0 5 0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DisabledForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                </Grid>
                            </TreeDataTemplate>

                            <DataTemplate DataType="vm:ExceptionDetailsViewModel">
                                <Border Padding="8"
                                        CornerRadius="3"
                                        BorderThickness="2,0,0,0"
                                        BorderBrush="#EF5350"
                                        Background="{DynamicResource Layer1BackgroundBrush}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <SelectableTextBlock FontSize="10" TextWrapping="Wrap" Background="Transparent">
                                            <Run Text="{Binding Header, Mode=OneWay}" FontWeight="SemiBold" Foreground="#EF5350" />
                                            <LineBreak />
                                            <Run Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource ForegroundBrush}" />
                                        </SelectableTextBlock>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </TabItem>

            <TabItem Header="Export Options" LayerExtension.Layer="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Classes="ToggleSwitch"
                                      IsChecked="{Binding Options.OverrideOptions, Mode=TwoWay}"
                                      Content="{Binding $self.IsChecked, Converter={x:Static converters:BoolToToggleConverter.Instance}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Margin="5 2 0 0"
                                       Foreground="{DynamicResource DisabledForegroundBrush}"
                                       Text="Override default export options for this session"
                                       IsVisible="{Binding !Options.HasFeedback}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Margin="5 2 0 0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" Text="{Binding Options.FeedbackMessage}"
                                       IsVisible="{Binding Options.HasFeedback}" />

                            <Button Grid.Column="2" Click="OnMakeDefaultOptions" ToolTip.Tip="Save current options as your default settings"
                                    Padding="4" BorderThickness="1" Margin="5 0 0 0"
                                    IsEnabled="{Binding Options.OverrideOptions}" Focusable="False"
                                    Classes="ToolbarButton">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SaveIcon}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="3" Click="OnResetOptions" ToolTip.Tip="Reset all options to default settings"
                                    Padding="4" BorderThickness="1" Margin="5 0 0 0"
                                    IsEnabled="{Binding Options.OverrideOptions}" Focusable="False"
                                    Classes="ToolbarButton">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path StrokeThickness="2" Stroke="{DynamicResource ForegroundBrush}" Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                        <Path StrokeThickness="2" Stroke="{DynamicResource ForegroundBrush}" Data="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Separator Grid.Row="1" Classes="CustomSeparator" Margin="0 5 0 10" />

                        <controls:ExportOptionsControl Grid.Row="2"
                                                       DataContext="{Binding Options}"
                                                       IsEnabled="{Binding OverrideOptions}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Background="{DynamicResource Layer1BackgroundBrush}"
                LayerExtension.IncreaseLayer="True">
            <Grid Margin="30, 12, 6, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" MinWidth="78" Margin="0 0 12 0" IsDefault="False" IsCancel="True"
                        IsVisible="{Binding IsRunning}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                        Content="Cancel" Click="OnCancelClick"
                        Classes="AccentButton">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
                        <SolidColorBrush x:Key="AccentHighlightBrush" Color="#EF5350" />
                        <SolidColorBrush x:Key="AccentIntenseHighlightBrush" Color="#EF5350" />
                        <SolidColorBrush x:Key="AccentInteractionBrush" Color="#C62828" />
                        <SolidColorBrush x:Key="AccentInteractionBorderBrush" Color="#B71C1C" />
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" MinWidth="78" Margin="0 0 12 0" IsDefault="False" IsCancel="False"
                        IsEnabled="{Binding CanExport}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                        Content="Clear Queue" Click="OnClearQueueClick">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsRunning" />
                            <Binding Path="!IsFinished" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>

                <Button Grid.Column="3" MinWidth="78" Margin="0 0 12 0" IsDefault="False" IsCancel="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                        Content="Export"
                        IsEnabled="{Binding CanExport}"
                        IsVisible="{Binding !IsFinished}"
                        Click="OnExportClick" />

                <Button Grid.Column="3" MinWidth="78" Margin="0 0 12 0" IsDefault="False" IsCancel="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                        Content="OK"
                        IsVisible="{Binding IsFinished}"
                        Click="OnOkClick" />
            </Grid>
        </Border>
    </Grid>
</FWindow>
