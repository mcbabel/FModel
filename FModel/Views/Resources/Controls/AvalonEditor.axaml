<UserControl x:Class="FModel.Views.Resources.Controls.AvalonEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="https://github.com/avaloniaui/avaloniaedit">
    <UserControl.Styles>
        <Style Selector="Grid#SearchBar">
            <Setter Property="ZIndex" Value="0" />
        </Style>
        <Style Selector="Grid#SearchBar.open">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="TextBox#WpfSuckMyDick">
            <Setter Property="Watermark" Value="Write your pattern and press enter..." />
        </Style>
        <Style Selector="TextBox#WpfSuckMyDick.regex">
            <Setter Property="Watermark" Value="Write your regex pattern and press enter..." />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SearchBar" Grid.Row="0" Margin="3 0" HorizontalAlignment="Right" Width="500"
              Classes.open="{Binding HasSearchOpen}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5 0 0 0" IsHitTestVisible="False">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SearchIcon}" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <TextBox x:Name="WpfSuckMyDick" Grid.Column="0" Grid.ColumnSpan="2" Padding="25 0 0 0" AcceptsTab="False" AcceptsReturn="False"
                     VerticalContentAlignment="Center"
                     Text="{Binding TextToFind, Mode=TwoWay}" Classes.regex="{Binding UseRegEx}"
                     BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton ToolTip.Tip="Search Up" Padding="5" IsChecked="{Binding SearchUp}" Focusable="False" Classes="ToolbarToggleButton">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SearchUpIcon}" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton ToolTip.Tip="Match Whole Word" Padding="5" IsChecked="{Binding WholeWord}" Focusable="False" Classes="ToolbarToggleButton">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource WholeWordIcon}" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton ToolTip.Tip="Match Case" Padding="5" IsChecked="{Binding CaseSensitive}" Focusable="False" Classes="ToolbarToggleButton">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource MatchCaseIcon}" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton ToolTip.Tip="Regex" Padding="5" IsChecked="{Binding UseRegEx}" Focusable="False" Classes="ToolbarToggleButton">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource RegexIcon}" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <Button ToolTip.Tip="Clear Search Filter" Padding="5" Focusable="False" Click="OnDeleteSearchClick" Classes="ToolbarButton">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource BackspaceIcon}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
            <Button Grid.Column="2" ToolTip.Tip="Close" Padding="5" Focusable="False" Click="OnCloseClick" Margin="2 0 0 0"
                    Classes="ToolbarButton" BorderThickness="1"
                    Background="{DynamicResource Layer3BackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}">
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource CloseIcon}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <avalonEdit:TextEditor x:Name="MyAvalonEditor" Grid.Row="0" Grid.RowSpan="2" SyntaxHighlighting="{Binding Highlighter}" Document="{Binding Document}"
                               FontFamily="{DynamicResource CodeFontFamily}" FontSize="{Binding FontSize}" IsReadOnly="True" ShowLineNumbers="True" Foreground="#DAE5F2"
                               Background="{DynamicResource Layer3BackgroundBrush}"
                               TextChanged="OnTextChanged" PointerHover="OnMouseHover" PointerHoverStopped="OnMouseHoverStopped" />
    </Grid>
</UserControl>
