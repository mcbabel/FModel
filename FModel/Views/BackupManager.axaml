<FWindow x:Class="FModel.Views.BackupManager"
         xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:converters="using:FModel.Views.Resources.Converters"
         Title="Backup Manager"
         WindowStartupLocation="CenterScreen" CanResize="False" SizeToContent="Height" Loaded="OnLoaded">
    <Grid LayerExtension.Layer="2" Margin="10" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="You can only use backup files when loading new &amp; modified archives. FModel will compare your local archives with the backup file you selected to filter packages and only show what you asked. We provide pre-created backups for some popular games but you can still create your own that will store information about all the game's packages at time T, for later use." />

        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Click="OnCreateBackupClick" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Classes="AccentButton" Content="Create" />

        <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Classes="CustomSeparator" Tag="PRE-CREATED BACKUP FILES" />

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                   Text="{Binding SelectedBackup.FileSize, Converter={x:Static converters:SizeToStringConverter.Instance}, FallbackValue='Backup', StringFormat='Backup ({0})'}" />
        <!-- WPF DataTrigger: disabled when BackupsView.Count == 0 -->
        <ComboBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding BackupsView}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                  IsEnabled="{Binding !BackupsView.IsEmpty}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Content="Download" Click="OnDownloadClick" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" IsEnabled="{Binding !BackupsView.IsEmpty}" />
    </Grid>
</FWindow>
