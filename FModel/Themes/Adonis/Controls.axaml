    </Style>
    <Style Selector="^[IsDefault=True]">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Layer1InteractionBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Layer1InteractionBorderBrush}"/>
