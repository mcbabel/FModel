        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Panel Width="14" Height="14" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
            <Ellipse Name="PART_CheckMark" Margin="4" Fill="{TemplateBinding Foreground}" IsVisible="False"/>
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
