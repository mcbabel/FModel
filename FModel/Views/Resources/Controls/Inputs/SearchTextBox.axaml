<UserControl x:Class="FModel.Views.Resources.Controls.Inputs.SearchTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5 2 0 0" IsHitTestVisible="False">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SearchIcon}" />
                </Canvas>
            </Viewbox>
        </Grid>

        <TextBox x:Name="TextBox" x:FieldModifier="public" Grid.Column="0" Grid.ColumnSpan="2" AcceptsTab="False" AcceptsReturn="False"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                 Padding="25 0 0 0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                 Watermark="{Binding Watermark, ElementName=Root}" />

        <Button Grid.Column="1" ToolTip.Tip="Clear Search Filter" Padding="5"
                Click="OnClearButtonClick" Classes="ToolbarButton">
            <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource BackspaceIcon}" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
